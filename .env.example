# Neon Postgres (pooled connection string from the Neon Console)
DATABASE_URL=

# Managed Better Auth — copy from Neon Console → Project → Branch → Auth → Configuration
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Public site URL used for OAuth / magic-link return paths
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional OpenAI-compatible enrichment. The app stays usable without these.
# SpaceXAI / xAI defaults:
#   AI_BASE_URL=https://api.x.ai/v1
#   AI_MODEL=grok-4.6
#   AI_API_KEY=...   (or XAI_API_KEY)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
XAI_API_KEY=
