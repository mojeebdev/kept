# Neon Postgres (pooled connection string from the Neon Console)
DATABASE_URL=

# Managed Better Auth — copy from Neon Console → Project → Branch → Auth → Configuration
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Public site URL used for the Google OAuth return path
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional OpenAI-compatible enrichment. The app stays usable without these.
# Recommended free preview NIM for Kept:
#   https://build.nvidia.com/nvidia/nemotron-3.5-lightning-30b-a3b
# Key: https://build.nvidia.com/settings/api-keys
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY=
XAI_API_KEY=
